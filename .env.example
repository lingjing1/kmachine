# =================================================================
# Cook.ai 專案環境變數範本 (.env.example)
# =================================================================
# 使用方式：cp .env.example .env 並填入實際數值
# 切勿將真實的 secrets 提交到 git！.env 已加入 .gitignore
# =================================================================

# --- 前端配置 (Vite Build-time 注入) ---
# Docker 構建時注入的後端 API URL（依部署環境調整）
VITE_API_URL=http://localhost:8888

# --- 後端服務配置 ---
# API Server Port（需與 docker-compose.yml 的 ports 對應）
BACKEND_PORT=8888

# --- LLM API Keys ---
# 至 https://platform.openai.com/api-keys 取得
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# --- Database Configuration ---
# 主資料庫（PostgreSQL + pgvector）
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>
# Online Judge 資料庫（debugging_problems router 需要）
OJ_DATABASE_URL=postgresql://<user>:<password>@<host>/onlinejudge

# --- JWT Authentication ---
# 用 `openssl rand -base64 32` 產生
JWT_SECRET_KEY=replace-me-with-a-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=180

# --- LangSmith (選填，用於 LangGraph 追蹤) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key-here
LANGCHAIN_PROJECT=Cook.ai - Material RAG

# --- Email / SMTP (用於忘記密碼、通知信)---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-account@example.com
# Gmail 需要使用 App Password (https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=your-smtp-app-password-here

# --- 應用程式行為旗標 ---
# 強制重新抽取教材（測試用，正式環境請設 false）
FORCE_INGEST=false
# 啟用 RAG 自動評估（消融實驗用）
ENABLE_RAG_AUTO_EVALUATION=true

# --- 實驗環境設定 ---
# 指定哪些 course_id 進入消融實驗模式（list of ints）
EXPERIMENT_COURSE_IDS=[]
